{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_YOUR_BACKEND_URL/api/:path*"
    },
    {
      "source": "/share/:path*",
      "destination": "https://REPLACE_WITH_YOUR_BACKEND_URL/share/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
